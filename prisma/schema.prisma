generator client {
  provider      = "prisma-client-js"
  // native: geliştirme makinesi; debian-openssl-3.0.x: node:20-bookworm-slim
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id           String  @id
  orderNo      String
  customer     String
  product      String
  quantity     Float
  unit         String
  status       String
  orderDate    String
  deliveryDate String
  priority     String
  warehouse    String
  value        Decimal @db.Decimal(18, 4)
  recipeNo     String?
  batchNo      String? @unique
  destination  String?
  shipmentNote String?
  stockDeducted Boolean @default(false)

  @@index([status])
  @@index([orderDate])
}

model Recipe {
  id          String  @id
  code        String?
  productCode String?
  orderId     String
  productName String
  createdAt   String
  createdBy   String
  lines       String
  extras      String
  status      String
}

model RawMaterial {
  id       String  @id
  sku      String  @unique
  name     String
  category String
  unit     String
  unitCost Decimal @db.Decimal(18, 4)
}

model RawMaterialOrder {
  id                String    @id
  orderNo           String
  materialName      String
  sku               String
  supplier          String
  quantity          Float
  unit              String
  unitPrice         Decimal   @db.Decimal(18, 4)
  totalPrice        Decimal   @db.Decimal(18, 4)
  status            String
  source            String
  sourceNote        String?
  targetWarehouseId String
  orderDate         String
  expectedDelivery  String?
  receivedDate      String?
  qcStartedAt       String?
  qcCompletedAt     String?
  warehousedAt      String?
  returnedAt        String?
  lotNo             String?
  invoiceNo         String?
  qcNotes           String?
  qcAnalyst         String?
  targetWarehouse   Warehouse @relation(fields: [targetWarehouseId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([sku])
  @@index([targetWarehouseId])
}

model Warehouse {
  id               String               @id
  name             String
  type             String
  description      String
  location         String
  capacity         Float
  used             Float
  temperature      String
  humidity         String
  manager          String
  items            Int
  lastAudit        String
  stockItems       WarehouseStockItem[] @relation("StockWarehouse")
  replenishTargets WarehouseStockItem[] @relation("ReplenishFrom")
  incomingOrders   RawMaterialOrder[]
  transfersFrom    StockTransfer[]      @relation("TransferFrom")
  transfersTo      StockTransfer[]      @relation("TransferTo")
}

model WarehouseStockItem {
  id                       String     @id
  sku                      String
  name                     String
  category                 String
  warehouseId              String
  quantity                 Float
  unit                     String
  minStock                 Float
  maxStock                 Float?
  lotNo                    String
  expiryDate               String
  status                   String
  temperature              String?
  replenishFromWarehouseId String?
  labTargetQuantity        Float?
  labDirectEntry           Boolean    @default(false)
  warehouse                Warehouse  @relation("StockWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  replenishFrom            Warehouse? @relation("ReplenishFrom", fields: [replenishFromWarehouseId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([status])
  @@index([sku, warehouseId])
}

model StockTransfer {
  id              String    @id @default(cuid())
  fromWarehouseId String
  toWarehouseId   String
  sourceItemId    String
  materialName    String
  sku             String
  quantity        Float
  unit            String
  reason          String
  status          String
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  note            String?
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
}

model ProductionLine {
  id              String @id
  code            String?
  name            String
  product         String
  status          String
  efficiency      Float
  currentBatch    String
  outputToday     Float
  targetToday     Float
  operator        String
  lastMaintenance String
}

model ProductionBatch {
  id            String @id
  batchNo       String @unique
  product       String
  line          String
  status        String
  queuePosition Int?
  quantity      Float
  unit          String
  startDate     String
  endDate       String
  yield         Float
  qcScore       Float
  materialUsage String?

  @@index([line, status])
  @@index([line, queuePosition])
}

model LabExperiment {
  id             String  @id
  code           String  @unique
  title          String
  researcher     String
  department     String
  status         String
  startDate      String
  dueDate        String
  progress       Float
  samples        Int
  priority       String
  productName    String  @default("")
  recipeCode     String  @default("")
  materialUsages  String  @default("[]")
  recipeId       String?
  completionNote String?
}

model LabSample {
  id           String  @id
  sampleNo     String  @unique
  product      String
  batchNo      String
  type         String
  status       String
  receivedDate String
  analyst      String
  result       String?
  quantity     Float?
  unit         String?
  stockItemId  String?
  sourceKind   String  @default("product")
  disposition  String  @default("open")
}

model Customer {
  id      String  @id
  name    String
  contact String
  address String
  taxNo   String
  email   String
  active  Boolean @default(true)
}

model Supplier {
  id                   String  @id
  name                 String
  contact              String  @default("")
  address              String  @default("")
  active               Boolean @default(true)
  invoiceName          String  @default("")
  accountList          String  @default("Tedarikçi")
  currency             String  @default("TL")
  accountCode          String  @default("")
  onlineTransactions   Boolean @default(true)
  notes                String  @default("")
  iban                 String  @default("")
  country              String  @default("Türkiye")
  city                 String  @default("")
  district             String  @default("")
  mobile               String  @default("")
  email                String  @default("")
  landline             String  @default("")
  accountKind          String  @default("Gerçek kişi / Şahıs Firması")
  taxNo                String  @default("")
  taxOffice            String  @default("")
  nationalId           String  @default("")
  openingBalance       Decimal @default(0) @db.Decimal(18, 4)
  openingBalanceType   String  @default("Borçlu")
  paymentTermDays      Int     @default(0)
  creditLimit          Decimal @default(0) @db.Decimal(18, 4)
  salesPriceList       String  @default("1. Satış Fiyatı")
  branch               String  @default("Merkez Şube")
  assignedPersonnel    String  @default("")
  paymentTaxNo         String  @default("")
  relatives            String  @default("[]")
  guarantors           String  @default("[]")
}

model Personnel {
  id         String  @id
  firstName  String
  lastName   String
  department String
  title      String
  email      String
  phone      String
  hireDate   String
  salary     Decimal @db.Decimal(18, 4)
  iban       String
}

model FinishedProduct {
  id         String @id
  sku        String
  name       String
  unit       String
  minStock   Float
  maxStock   Float
  lotNo      String
  expiryDate String
}

model Invoice {
  id                 String        @id
  invoiceNo          String        @unique
  party              String
  kind               String
  issueDate          String
  dueDate            String
  amount             Decimal       @db.Decimal(18, 4)
  status             String
  documentType       String        @default("")
  bucket             String        @default("")
  confirmed          Boolean       @default(true)
  eDocument          String        @default("e-Arşiv")
  scenario           String        @default("TEMELFATURA")
  series             String        @default("")
  currency           String        @default("TRY")
  fxRate             Float         @default(1)
  partyTaxNo         String        @default("")
  partyTaxOffice     String        @default("")
  partyAddress       String        @default("")
  partyCity          String        @default("")
  partyDistrict      String        @default("")
  partyPhone         String        @default("")
  partyEmail         String        @default("")
  sellerName         String        @default("HamdPharma")
  sellerTaxNo        String        @default("")
  sellerTaxOffice    String        @default("")
  sellerAddress      String        @default("")
  paymentMethod      String        @default("Cari hesap")
  relatedDispatchNo  String        @default("")
  relatedOrderNo     String        @default("")
  notes              String        @default("")
  validUntil         String        @default("")
  deliveryTerm       String        @default("")
  preparedBy         String        @default("")
  subtotal           Decimal       @default(0) @db.Decimal(18, 4)
  totalDiscount      Decimal       @default(0) @db.Decimal(18, 4)
  totalVat           Decimal       @default(0) @db.Decimal(18, 4)
  withholding        Decimal       @default(0) @db.Decimal(18, 4)
  paidAmount         Decimal       @default(0) @db.Decimal(18, 4)
  lines              InvoiceLine[]
  events             InvoiceEvent[]
}

model InvoiceLine {
  id            String  @id
  invoiceNo     String
  description   String
  quantityLabel String
  unitPrice     Decimal @db.Decimal(18, 4)
  lineTotal     Decimal @db.Decimal(18, 4)
  quantity      Float   @default(1)
  unit          String  @default("Adet")
  discountRate  Float   @default(0)
  vatRate       Float   @default(20)
  vatAmount     Decimal @default(0) @db.Decimal(18, 4)
  lineNet       Decimal @default(0) @db.Decimal(18, 4)
  invoice       Invoice @relation(fields: [invoiceNo], references: [invoiceNo], onDelete: Cascade)

  @@index([invoiceNo])
}

model InvoiceEvent {
  id        String   @id
  invoiceNo String
  kind      String
  status    String   @default("")
  amount    Decimal  @default(0) @db.Decimal(18, 4)
  method    String   @default("")
  note      String   @default("")
  fileName  String   @default("")
  fileId    String   @default("")
  mimeType  String   @default("")
  createdAt DateTime @default(now())
  createdBy String   @default("")
  invoice   Invoice  @relation(fields: [invoiceNo], references: [invoiceNo], onDelete: Cascade)

  @@index([invoiceNo])
}

model ChequeNote {
  id               String                   @id
  docNo            String                   @unique
  kind             String
  direction        String
  party            String
  issueDate        String
  bankName         String                   @default("")
  serialNo         String                   @default("")
  totalAmount      Decimal                  @db.Decimal(18, 4)
  currency         String                   @default("TRY")
  status           String                   @default("Portföy")
  notes            String                   @default("")
  relatedInvoiceNo String                   @default("")
  createdAt        DateTime                 @default(now())
  createdBy        String                   @default("")
  installments     ChequeNoteInstallment[]
}

model ChequeNoteInstallment {
  id             String     @id
  chequeNoteId   String
  sequence       Int
  dueDate        String
  amount         Decimal    @db.Decimal(18, 4)
  serialNo       String     @default("")
  status         String     @default("Bekliyor")
  paidAt         String     @default("")
  invoiceNo      String     @default("")
  paymentEventId String     @default("")
  chequeNote     ChequeNote @relation(fields: [chequeNoteId], references: [id], onDelete: Cascade)

  @@index([chequeNoteId])
  @@index([status])
  @@index([dueDate])
}

model DeliveryNote {
  id               String             @id
  noteNo           String             @unique
  party            String
  kind             String
  issueDate        String
  shipDate         String
  warehouse        String
  relatedOrderNo   String             @default("")
  relatedInvoiceNo String             @default("")
  status           String
  partyTaxNo       String             @default("")
  partyAddress     String             @default("")
  partyCity        String             @default("")
  partyDistrict    String             @default("")
  partyCountry     String             @default("Türkiye")
  partyPostalCode  String             @default("")
  driverName       String             @default("")
  driverNationalId String             @default("")
  plateNo          String             @default("")
  trailerPlate     String             @default("")
  plateOrigin      String             @default("Türkiye plaka")
  shipMethod       String             @default("Kendi aracımla gönderiyorum")
  dispatchAddress  String             @default("")
  issueTime        String             @default("")
  shipTime         String             @default("")
  relatedOrderDate String             @default("")
  packages         String             @default("")
  notes            String             @default("")
  lines            DeliveryNoteLine[]
}

model DeliveryNoteLine {
  id            String       @id
  noteNo        String
  description   String
  quantityLabel String
  unit          String
  note          DeliveryNote @relation(fields: [noteNo], references: [noteNo], onDelete: Cascade)

  @@index([noteNo])
}

model LedgerEntry {
  id          String  @id
  date        String
  documentNo  String
  description String
  category    String
  direction   String
  amount      Decimal @db.Decimal(18, 4)
  status      String
}

model BudgetRow {
  id         String  @id
  department String
  annual     Decimal @db.Decimal(18, 4)
  spent      Decimal @db.Decimal(18, 4)
}

model BudgetCashEntry {
  id          String   @id
  direction   String
  party       String
  category    String
  amount      Decimal  @db.Decimal(18, 4)
  date        String
  dueDate     String   @default("")
  description String   @default("")
  invoiceNo   String   @default("")
  documented  Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdBy   String   @default("")

  @@index([direction])
  @@index([date])
  @@index([dueDate])
  @@index([invoiceNo])
}

model BudgetCategory {
  id        String @id
  direction String
  name      String

  @@unique([direction, name])
  @@index([direction])
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actor      String
  action     String
  entityType String
  entityId   String?
  summary    String
  before     String?
  after      String?
  ipAddress  String?

  @@index([entityType])
  @@index([createdAt])
}

model BackupRecord {
  id        String   @id @default(cuid())
  filename  String
  filepath  String
  sizeBytes Int
  createdAt DateTime @default(now())
  createdBy String
  note      String?
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  passwordHash       String
  role               String
  active             Boolean   @default(true)
  /// true ise kullanıcı giriş yaptığında şifre değiştirme ekranına zorlanır
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  /// Ardışık başarısız giriş sayısı; başarılı girişte sıfırlanır
  failedAttempts     Int       @default(0)
  /// Doluysa bu zamana kadar giriş reddedilir
  lockedUntil        DateTime?
  /// Artınca eski JWT oturumları geçersiz olur (şifre/rol/aktiflik değişimi)
  tokenVersion       Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentSettings {
  id             String   @id @default("default")
  companyName    String   @default("HamdPharma")
  legalTitle     String   @default("")
  taxOffice      String   @default("")
  taxNo          String   @default("")
  mersisNo       String   @default("")
  tradeRegister  String   @default("")
  address        String   @default("")
  city           String   @default("")
  district       String   @default("")
  phone          String   @default("")
  email          String   @default("")
  website        String   @default("")
  iban           String   @default("")
  bankName       String   @default("")
  authorizedName String   @default("")
  footerNote     String   @default("")
  logoDataUrl    String   @default("")
  showLogo       Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
