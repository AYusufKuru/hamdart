[Unit]
Description=HamdPharma daily PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hamdart
EnvironmentFile=-/opt/hamdart/.env
ExecStart=/bin/bash /opt/hamdart/deploy/backup-daily.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
