# Bu dosyayı proje kökünde .env olarak kopyalayın:
#   cp deploy/env.example .env
#
# install-ubuntu.sh ilk çalıştırmada kopyalar, POSTGRES_PASSWORD ve AUTH_SECRET
# üretir, sonra ADMIN_INITIAL_PASSWORD için durur.

# PostgreSQL (Docker iç ağı — dışarı açılmaz)
POSTGRES_USER=hamdart
POSTGRES_PASSWORD=GÜÇLÜ_BİR_ŞİFRE_BELİRLEYİN
POSTGRES_DB=hamdart

# Oturum imzalama — rastgele, en az 32 karakter
AUTH_SECRET=üretim-icin-rastgele-en-az-32-karakterlik-anahtar

# Alan adı (Let's Encrypt + HTTPS). DNS A kaydı bu VM'in genel IP'sine bakmalı.
DOMAIN=BURAYA_ALAN_ADI
CERTBOT_EMAIL=BURAYA_EPOSTA

# Çerez Secure bayrağı. HTTPS varken true bırakın.
# Sertifika alınana kadar giriş çalışmazsa geçici: AUTH_COOKIE_SECURE=0
# AUTH_COOKIE_SECURE=true

# Takvim günleri ve gösterim — konteynerlerde de aynı
TZ=Europe/Istanbul

# Yedekler (VM içi). Dış kopya (Windows D:) için deploy/KURTARMA.md
BACKUP_HOST_DIR=/var/lib/hamdart/backups
# BACKUP_OFFSITE_DIR=/mnt/hamdart-offsite
# BACKUP_OFFSITE_REQUIRED=1
# BACKUP_KEEP_DAYS=14
# BACKUP_KEEP_MONTHLY_DAYS=365

# Açılışta prisma migrate deploy atlanır (yalnızca bakım)
# SKIP_MIGRATE=1

# ─────────────────────────────────────────────────────────────────────
# Yönetici hesabının İLK şifresi
#
# Kurulumda yalnızca "admin" kullanıcısı oluşturulur. Bu şifreyle giriş
# yaptığınızda uygulama sizi doğrudan şifre değiştirme ekranına götürür;
# yeni şifrenizi belirlemeden hiçbir sayfaya erişemezsiniz.
#
# Kural: en az 12 karakter, küçük harf + büyük harf + rakam içermeli.
#        Kullanıcı adını ("admin") veya adınızı içeremez.
#
# Diğer kullanıcıları giriş yaptıktan sonra
# "Denetim & Yedekleme > Kullanıcılar" ekranından oluşturursunuz.
# ─────────────────────────────────────────────────────────────────────
# Aşağıdaki değeri MUTLAKA değiştirin — bu hâliyle kurulum durur.
ADMIN_INITIAL_PASSWORD=BURAYA_GUCLU_BIR_SIFRE_YAZIN
